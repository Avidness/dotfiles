[core]
	editor = vim
[user]
	name = avidness
	email = adavidness@gmail.com
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
# Machine-specific settings (not tracked) go in ~/.gitconfig.local.
[include]
	path = ~/.gitconfig.local
